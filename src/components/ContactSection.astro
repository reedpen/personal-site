---
import type { SiteContent } from "../data/site";
import InlineLinks from "./InlineLinks.astro";

type Props = SiteContent["contact"];

const { prompt, heading, body, email, links = [] } = Astro.props;
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <p class="section-label">{prompt}</p>
  <h2 id="contact-title">{heading}</h2>
  <p>{body}</p>
  <address>
    <a class="contact-email" href={`mailto:${email}`}
      >{email} <span aria-hidden="true">→</span></a
    >
  </address>
  <InlineLinks links={links} ariaLabel="Other contact links" />
</section>
