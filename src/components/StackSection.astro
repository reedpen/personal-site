---
import type { StackCategory } from "../data/site";
import SectionBox from "./SectionBox.astro";

type Props = {
  categories: readonly StackCategory[];
};

const { categories } = Astro.props;

const categoryId = (label: string, index: number) =>
  `stack-${index}-${
    label
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "") || "category"
  }`;
---

<SectionBox id="stack" title="technology stack" path="~/stack">
  <div class="stack-grid">
    {
      categories.map((category, index) => (
        <section
          class="stack-category"
          aria-labelledby={categoryId(category.label, index)}
        >
          <h3 id={categoryId(category.label, index)}>{category.label}</h3>
          <ul>
            {category.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</SectionBox>
