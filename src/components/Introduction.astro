---
import type { SiteContent } from "../data/site";
import InlineLinks from "./InlineLinks.astro";

type Props = SiteContent["introduction"];

const { name, role, summary, asciiArt = "", links = [] } = Astro.props;
---

<section class="introduction" id="top" aria-labelledby="introduction-title">
  {
    asciiArt.trim() && (
      <pre class="ascii-art" aria-label={`${name} ASCII art`}>
        {asciiArt}
      </pre>
    )
  }
  <h1 id="introduction-title">{name}</h1>
  <p class="section-label">{role}</p>
  <p class="introduction-summary">{summary}</p>
  <InlineLinks links={links} ariaLabel="External profiles" />
</section>
