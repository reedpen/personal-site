---
import type { Education } from "../lib/portfolio.mjs";
import SectionBox from "./SectionBox.astro";

type Props = {
  entries: readonly Education[];
};

const { entries } = Astro.props;
---

<SectionBox id="education" title="education" path="~/school">
  <div class="entry-list">
    {entries.map((entry) => (
      <article class="entry">
        <header class="entry-header">
          <div>
            <h3>{entry.institution}</h3>
            <p class="credential">{entry.credential}</p>
          </div>
          <div class="entry-meta education-meta">
            <span>{entry.date}</span>
            {entry.location && <span>{entry.location}</span>}
          </div>
        </header>
        {entry.roles && entry.roles.length > 0 && (
          <ul class="highlight-list">
            {entry.roles.map((role) => (
              <li>{`${role.title}, ${role.organization} (${role.date.replace("-Present", "–present")}): ${role.bullets.join(" ")}`}</li>
            ))}
          </ul>
        )}
      </article>
    ))}
  </div>
</SectionBox>
