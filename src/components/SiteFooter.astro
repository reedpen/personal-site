---
import type { SiteContent } from "../data/site";

type Props = SiteContent["footer"] & {
  email: string;
};

const { text, linkLabel, email } = Astro.props;
---

<footer class="site-footer">
  <span>{text}</span>
  <a href={`mailto:${email}`}>{linkLabel} <span aria-hidden="true">→</span></a>
</footer>
