---
import type { SiteContent } from "../data/site";
import { site } from "../data/site";
import { blogNames, publishedPosts, type BlogName } from "../lib/posts";

type Props = SiteContent["navigation"] & {
  /** The blog the current page belongs to, if any. */
  current?: BlogName;
};

const { label, links, current } = Astro.props;

// A blog appears in navigation only once it has at least one published post.
const blogLinks = [];
for (const blog of blogNames) {
  if ((await publishedPosts(blog)).length > 0)
    blogLinks.push({ blog, label: site.blogs[blog].title, href: `/${blog}/` });
}
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="nav-label" href="/#top">
      {label}
    </a>
    <ul class="nav-links">
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
      {blogLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={link.blog === current ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
